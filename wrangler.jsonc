{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "impulsecaster",
  "compatibility_date": "2026-05-03",
  "observability": {
    "enabled": true
  },
  "main": "./workers/app.ts",
  // the card data (scripts/card-data.ts), kept apart from the deploy and uploaded each night by
  // scripts/upload-card-data.sh. Locally it's an empty stand-in, so pages ask Scryfall instead.
  "r2_buckets": [
    { "binding": "CARD_DATA", "bucket_name": "impulsecaster-cards-data" }
  ],
  // the deploy's version, so saved card pages are only served by the deploy that made them (workers/app.ts)
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "routes": [
    { "pattern": "impulsecaster.cards", "custom_domain": true }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
